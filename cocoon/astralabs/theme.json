    "icon_roundness": 0.0,
    "icon_scale": 1.0,
    "hover_scale": 1.0,
    "icon_style": "FLAT",
    "hero_display_style": "FULLSCREEN",
    "hero_logo_scale": 0.45,
    "hero_folder_logo_scale": 0.5,
    "hero_gradient_style": "BLACK_GRADIENT",
    "surface_material": "SOLID",
    "cursor_style": "ALTERNATIVE",
    "highlight_thickness": 0.6,
    "dock_icon_shape": "SQUARE"
