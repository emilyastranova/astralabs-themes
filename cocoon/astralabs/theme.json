{
  "name": "AstraLabs",
  "author": "Emily Astranova",
  "version": "1.0.0",
  "description": "Carbon, Bone and Acid from astralabs.dev. Square tiles, a corner cursor, a live dot-field wallpaper with an oscilloscope beam, line-art smart folders and synthesized lab-equipment sounds.",
  "credits": "Design and assets by Emily Astranova. Martian Mono by Evil Martians, SIL Open Font License 1.1.",
  "website": "https://astralabs.dev",
  "theme_mode": "DARK",
  "wallpaper_main": "main",
  "wallpaper_external": "external",
  "color_scheme": {
    "background_gradient_start": "#0A0909",
    "background_gradient_end": "#0A0909",
    "card_gradient_start": "#131212",
    "card_gradient_end": "#131212",
    "text_primary": "#EDE6E1",
    "text_secondary": "#8E8380",
    "icon_tint": "#EDE6E1",
    "tile_background": "#131212",
    "tile_border": "#2C2A29",
    "toggle_off_gradient_start": "#2C2A29",
    "toggle_off_gradient_end": "#2C2A29",
    "toggle_thumb_gradient_start": "#EDE6E1",
    "toggle_thumb_gradient_end": "#EDE6E1",
    "drop_shadow": "#00000000",
    "inner_shadow_light": "#00000000",
    "inner_shadow_dark": "#00000000",
    "success": "#4DFF88",
    "warning": "#FFA21F",
    "divider": "#2C2A29",
    "accent_gradient_start": "#B6FF2E",
    "accent_gradient_end": "#B6FF2E",
    "accent_glow": "#00B6FF2E",
    "selection_gradient_start": "#B6FF2E",
    "selection_gradient_end": "#B6FF2E"
